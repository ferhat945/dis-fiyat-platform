generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id             String    @id @default(cuid())
  name           String
  phone          String?
  email          String    @unique
  address        String?
  about          String?
  website        String?
  passwordHash   String
  isActive       Boolean   @default(true)
  lastAssignedAt DateTime?
  instagramUrl   String?   @db.VarChar(255)
  trialUsedAt    DateTime?
  trialEndsAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditBalance    Int       @default(0)
  isPremium        Boolean   @default(false)
  premiumStartedAt DateTime?
  premiumExpiresAt DateTime?
  autoRenewPremium Boolean   @default(false)

  coverages        ClinicCoverage[]
  blogPosts        BlogPost[]
  subscriptions    Subscription[]
  assignments      LeadAssignment[]
  distributionLogs LeadDistributionLog[]
  priceRanges      ClinicPriceRange[]
  pageViews        ClinicPageView[]
  paymentLogs      PaymentLog[]

  creditTransactions CreditTransaction[]

  @@map("clinics")
}

model BlogPost {
  id          String    @id @default(cuid())
  clinicId    String? // ✅ EKLE: yazıyı yazan klinik
  slug        String    @unique
  title       String
  excerpt     String?   @db.VarChar(320)
  content     String    @db.LongText
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull) // ✅ EKLE

  @@index([clinicId]) // ✅ EKLE
  @@index([isPublished, publishedAt])
  @@index([createdAt])
  @@map("BlogPost")
}

model ClinicCoverage {
  id       String  @id @default(cuid())
  clinicId String
  city     String
  service  String
  isActive Boolean @default(true)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, city, service])
  @@map("clinic_coverages")
}

model Subscription {
  id         String   @id @default(cuid())
  clinicId   String
  status     String
  quotaTotal Int
  quotaUsed  Int      @default(0)
  startedAt  DateTime @default(now())
  expiresAt  DateTime

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model LeadAssignment {
  id       String @id @default(cuid())
  leadId   String
  clinicId String

  unlocked    Boolean   @default(true)
  unlockedAt  DateTime?
  unlockPrice Int       @default(1)

  priorityUntil DateTime?
  notifiedAt    DateTime?

  status        String    @default("new")
  clinicNote    String?   @db.Text
  lastContactAt DateTime?

  createdAt DateTime @default(now())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([leadId, clinicId])
  @@index([leadId])
  @@index([clinicId])
  @@index([clinicId, createdAt])
  @@index([unlocked])
  @@map("lead_assignments")
}

model Lead {
  id                 String                @id @default(cuid())
  city               String
  service            String
  fullName           String
  phone              String
  email              String?
  message            String?
  intent             String
  source             String?
  status             String                @default("new")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  clinicNote         String?               @db.Text
  lastContactAt      DateTime?
  distributionLogs   LeadDistributionLog[]
  assignments        LeadAssignment[]
  consentAt          DateTime?
  consentTextVersion String?               @default("v1")
  ip                 String?
  userAgent          String?

  unlockCount Int @default(0)

  @@index([city, service, createdAt])
  @@map("lead")
}

model LeadDistributionLog {
  id        String   @id @default(cuid())
  leadId    String
  clinicId  String?
  city      String
  service   String
  assigned  Boolean  @default(false)
  reason    String
  details   Json?
  createdAt DateTime @default(now())

  lead   Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([clinicId])
  @@index([city, service])
  @@index([assigned])
  @@map("lead_distribution_logs")
}

model ClinicPriceRange {
  id        String   @id @default(cuid())
  clinicId  String
  city      String
  service   String
  minPrice  Int
  maxPrice  Int
  currency  String   @default("TRY")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([city, service])
  @@map("clinic_price_ranges")
}

model ClinicPageView {
  id        String   @id @default(cuid())
  clinicId  String
  day       DateTime
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, day])
  @@index([clinicId])
  @@index([day])
  @@map("clinic_page_views")
}

model PaymentLog {
  id       String @id @default(cuid())
  clinicId String

  packageCode String?
  kind        String
  credits     Int?

  amount   Int
  currency String @default("TRY")

  status   String  @default("started")
  provider String?

  // DişFiyat360 tarafından oluşturulan benzersiz sipariş numarası
  orderNumber String? @unique

  // iyzico veya ödeme kuruluşu işlem referansı
  providerRef String?

  // Aynı callback işleminin iki defa hak tanımlamasını önler
  callbackVerified Boolean @default(false)

  // Kullanıcı sözleşme onayları
  serviceAgreementAccepted     Boolean   @default(false)
  refundPolicyAccepted         Boolean   @default(false)
  immediatePerformanceAccepted Boolean   @default(false)
  agreementVersion             String?
  agreementAcceptedAt          DateTime?

  // Ödeme durum tarihleri
  paidAt     DateTime?
  failedAt   DateTime?
  canceledAt DateTime?

  // Dijital hizmet teslim kanıtları
  deliveredAt   DateTime?
  balanceBefore Int?
  balanceAfter  Int?

  // Premium paket teslim kanıtları
  premiumStartedAt DateTime?
  premiumExpiresAt DateTime?

  errorCode    String?
  errorMessage String? @db.Text

  // Eski ödeme kayıtları için korunur
  payload Json?

  // Ödeme başlangıç ve callback kayıtları
  requestPayload  Json?
  callbackPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  creditTransactions CreditTransaction[]

  @@index([clinicId, createdAt])
  @@index([clinicId, status])
  @@index([status])
  @@index([provider])
  @@index([providerRef])
  @@index([packageCode])
  @@index([deliveredAt])
  @@map("payment_logs")
}

model CreditTransaction {
  id String @id @default(cuid())

  clinicId String

  // İşlemin bağlı olduğu ödeme kaydı.
  // Lead açma gibi ödeme dışı hareketlerde boş olabilir.
  paymentLogId String?

  // Artı değer kredi ekler, eksi değer kredi düşer.
  amount Int

  // purchase, lead_unlock, premium_monthly_credit,
  // refund, admin_adjustment gibi işlem türleri
  type String

  note String? @db.Text

  // İşlem öncesi ve sonrası kredi bakiyesi
  balanceBefore Int?
  balanceAfter  Int?

  // Dijital hakkın hesaba tanımlandığı tarih
  deliveredAt DateTime?

  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  paymentLog PaymentLog? @relation(fields: [paymentLogId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([clinicId, createdAt])
  @@index([paymentLogId])
  @@index([type])
  @@index([deliveredAt])
  @@map("credit_transactions")
}
