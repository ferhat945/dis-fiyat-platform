generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id             String    @id @default(cuid())
  name           String
  phone          String?
  email          String    @unique
  address        String?
  about          String?
  website        String?
  passwordHash   String
  isActive       Boolean   @default(true)
  lastAssignedAt DateTime?
  instagramUrl   String?   @db.VarChar(255)
  trialUsedAt    DateTime?
  trialEndsAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditBalance    Int       @default(0)
  isPremium        Boolean   @default(false)
  premiumStartedAt DateTime?
  premiumExpiresAt DateTime?
  autoRenewPremium Boolean   @default(false)

  coverages        ClinicCoverage[]
  blogPosts        BlogPost[]
  subscriptions    Subscription[]
  assignments      LeadAssignment[]
  distributionLogs LeadDistributionLog[]
  priceRanges      ClinicPriceRange[]
  pageViews        ClinicPageView[]
  paymentLogs      PaymentLog[]

  creditTransactions CreditTransaction[]

  @@map("clinics")
}

model BlogPost {
  id          String    @id @default(cuid())
  clinicId    String? // ✅ EKLE: yazıyı yazan klinik
  slug        String    @unique
  title       String
  excerpt     String?   @db.VarChar(320)
  content     String    @db.LongText
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull) // ✅ EKLE

  @@index([clinicId]) // ✅ EKLE
  @@index([isPublished, publishedAt])
  @@index([createdAt])
  @@map("BlogPost")
}

model ClinicCoverage {
  id       String  @id @default(cuid())
  clinicId String
  city     String
  service  String
  isActive Boolean @default(true)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, city, service])
  @@map("clinic_coverages")
}

model Subscription {
  id         String   @id @default(cuid())
  clinicId   String
  status     String
  quotaTotal Int
  quotaUsed  Int      @default(0)
  startedAt  DateTime @default(now())
  expiresAt  DateTime

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model LeadAssignment {
  id        String   @id @default(cuid())
  leadId    String
  clinicId  String
  createdAt DateTime @default(now())

  unlocked      Boolean   @default(true)
  unlockedAt    DateTime?
  unlockPrice   Int       @default(1)
  priorityUntil DateTime?
  notifiedAt    DateTime?

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([leadId])
  @@index([clinicId])
  @@index([unlocked])
  @@map("lead_assignments")
}

model Lead {
  id                 String                @id @default(cuid())
  city               String
  service            String
  fullName           String
  phone              String
  email              String?
  message            String?
  intent             String
  source             String?
  status             String                @default("new")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  clinicNote         String?               @db.Text
  lastContactAt      DateTime?
  distributionLogs   LeadDistributionLog[]
  assignments        LeadAssignment[]
  consentAt          DateTime?
  consentTextVersion String?               @default("v1")
  ip                 String?
  userAgent          String?

  @@map("lead")
}

model LeadDistributionLog {
  id        String   @id @default(cuid())
  leadId    String
  clinicId  String?
  city      String
  service   String
  assigned  Boolean  @default(false)
  reason    String
  details   Json?
  createdAt DateTime @default(now())

  lead   Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([clinicId])
  @@index([city, service])
  @@index([assigned])
  @@map("lead_distribution_logs")
}

model ClinicPriceRange {
  id        String   @id @default(cuid())
  clinicId  String
  city      String
  service   String
  minPrice  Int
  maxPrice  Int
  currency  String   @default("TRY")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([city, service])
  @@map("clinic_price_ranges")
}

model ClinicPageView {
  id        String   @id @default(cuid())
  clinicId  String
  day       DateTime
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, day])
  @@index([clinicId])
  @@index([day])
  @@map("clinic_page_views")
}

model PaymentLog {
  id       String @id @default(cuid())
  clinicId String

  packageCode String?
  kind        String
  credits     Int?

  amount   Int
  currency String @default("TRY")

  status   String  @default("started")
  provider String?

  // Bizim oluşturacağımız benzersiz ödeme sipariş numarası
  orderNumber String? @unique

  // Bankanın döndürdüğü işlem veya referans numarası
  providerRef String?

  // Aynı callback'in iki kez hak tanımlamasını engeller
  callbackVerified Boolean @default(false)

  serviceAgreementAccepted     Boolean   @default(false)
  refundPolicyAccepted         Boolean   @default(false)
  immediatePerformanceAccepted Boolean   @default(false)
  agreementVersion             String?
  agreementAcceptedAt          DateTime?

  paidAt     DateTime?
  failedAt   DateTime?
  canceledAt DateTime?

  errorCode    String?
  errorMessage String? @db.Text

  // Eski ödeme kayıtları için korunuyor
  payload Json?

  // Yeni ödeme başlangıç ve callback kayıtları
  requestPayload  Json?
  callbackPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, createdAt])
  @@index([clinicId, status])
  @@index([status])
  @@index([provider])
  @@index([providerRef])
  @@index([packageCode])
  @@map("payment_logs")
}

model CreditTransaction {
  id String @id @default(cuid())

  clinicId String

  amount Int

  type String

  note String?

  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@map("credit_transactions")
}
